# MSVC build output -- regenerated by build.bat, including the produced d3d9.dll
build/

# Lookdev viewer build output -- regenerated by lookdev\build_viewer.bat
lookdev/bin/
lookdev/obj/

# Compiler/linker intermediates
*.pdb
*.obj
*.ilk
*.exp
*.idb
*.tlog

# NuGet restore output (Microsoft.DXSDK.D3DX) -- restored by the build
deps/packages/
scripts/collision/out/

# Local only: your folders for the tools (copy paths.example.ini) and the deploy target for build.bat
paths.local.ini
deploy.conf

# Python caches
__pycache__/

# IDE state
.vs/
*.user
